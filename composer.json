{
    "name": "hguenot/yii2-gsftp",
    "description": "Ftp is a FTP extension for [YII 2 Framework](http://www.yiiframework.com).",
    "type": "yii2-extension",
    "keywords": ["yii2","extension", "gftp"],
    "license": "GPL-3.0+",
    "authors": [
        {
            "name": "Hervé Guenot",
            "email": "herve@guenot.info"
        }
    ],
    "require": {
        "php": ">=7.1",
        "hguenot/yii2-gftp": ">=3.0.0",
		"phpseclib/phpseclib": "^3.0.36"
    },
    "require-dev": {
        "hguenot/yii2-gftp": "*",
		"phpseclib/phpseclib": "*",
        "phpunit/phpunit": "^9.6"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "gftp\\": ""
        },
        "files": ["autoload.php"]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
